# ==============================================================================
# HỆ THỐNG THƯ VIỆN ẢNH TRỰC TUYẾN - BIẾN MÔI TRƯỜNG
# Đã tự động cấu hình các cổng tránh xung đột (Port 80 -> 8088, Port 5432 -> 5433, Port 3000 -> 3001)
# ==============================================================================

# ===== CỔNG DỊCH VỤ TRÊN MÁY CHỦ (HOST PORTS) =====
PORT_NGINX=8088
PORT_BACKEND=5001
PORT_FRONTEND=5173
PORT_POSTGRES=5433
PORT_GRAFANA=3001
PORT_PROMETHEUS=9090

# ===== CƠ SỞ DỮ LIỆU POSTGRESQL =====
POSTGRES_DB=gallery_db
POSTGRES_USER=gallery_user
POSTGRES_PASSWORD=gallery_secure_pass_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URL kết nối khi chạy trong Docker:
DATABASE_URL=postgresql://gallery_user:gallery_secure_pass_2026@postgres:5432/gallery_db

# URL kết nối khi chạy cục bộ trực tiếp (Standalone / Host):
# Nếu PostgreSQL chạy trên host port 5433: postgresql://gallery_user:gallery_secure_pass_2026@localhost:5433/gallery_db
# Hoặc tự động fallback sang SQLite local nếu PostgreSQL chưa khởi động
LOCAL_DATABASE_URL=sqlite:///gallery_local.db

# ===== BACKEND FLASK =====
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=gallery_super_secret_key_prod_2026_xyz
JWT_SECRET_KEY=jwt_super_secret_key_gallery_2026_abc
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=33554432

# ===== FRONTEND =====
VITE_API_URL=http://localhost:8088/api
VITE_DIRECT_API_URL=http://localhost:5001/api

# ===== GRAFANA MONITORING =====
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
GF_USERS_ALLOW_SIGN_UP=false

# ===== SAO LƯU (BACKUP) =====
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
